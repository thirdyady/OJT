# TEMPLATE ONLY. Set real values in the hosting provider's environment settings.
# Browser values are public and embedded at build time.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Runtime values must refer to the SAME Supabase project as the browser values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_OR_SECRET_KEY
# Optional fallback for redirects outside a browser; use your canonical origin.
PUBLIC_SITE_URL=https://YOUR_PRODUCTION_DOMAIN
# SMTP credentials belong in Supabase Auth SMTP settings, never VITE_*.
